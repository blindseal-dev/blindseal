{
  "name": "@blindseal/sdk",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "description": "Blindseal SDK \u2014 build the on-chain verify instruction, submit attestations to Solana mainnet, verify attestations and disclosures off-chain.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ix": {
      "types": "./dist/ix.d.ts",
      "default": "./dist/ix.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.0",
    "@blindseal/verifier-wasm": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.9.0"
  },
  "files": [
    "dist",
    "idl"
  ],
  "keywords": [
    "solana",
    "zero-knowledge",
    "attestation",
    "mcp",
    "agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blindseal/blindseal.git"
  },
  "homepage": "https://github.com/blindseal/blindseal",
  "bugs": {
    "url": "https://github.com/blindseal/blindseal/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
