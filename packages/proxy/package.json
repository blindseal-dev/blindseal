{
  "name": "blindseal",
  "version": "0.5.3",
  "description": "Blindseal — a local MCP proxy that screens every tool call (four detection layers), redacts before the model-based layers, keeps a hash-chained audit log, and produces zero-knowledge attestations verifiable on Solana.",
  "license": "MIT",
  "homepage": "https://blindseal.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/blindseal-dev/blindseal.git"
  },
  "bugs": {
    "url": "https://github.com/blindseal-dev/blindseal/issues"
  },
  "type": "module",
  "bin": {
    "blindseal": "dist/index.js",
    "blindseal-audit": "dist/audit-view.js",
    "blindseal-decide": "dist/decide.js"
  },
  "files": [
    "dist",
    "dashboard",
    "fixtures"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-assets.mjs",
    "dev": "tsx src/index.ts",
    "view-audit": "tsx src/cli/audit-view.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:l3": "tsx bench/layer3-floor.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "blindseal-verifier-wasm": "workspace:*",
    "@noble/ciphers": "^1.2.1",
    "@solana/web3.js": "1.98.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@blindseal/corpus": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@blindseal/redactor": "workspace:*",
    "@blindseal/audit": "workspace:*",
    "blindseal-sdk": "workspace:*",
    "@blindseal/chain-reads": "workspace:*"
  },
  "keywords": [
    "mcp",
    "prompt-injection",
    "agents",
    "solana",
    "zero-knowledge",
    "attestation",
    "audit"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
